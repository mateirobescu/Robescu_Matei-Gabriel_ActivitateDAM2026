<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".AddActivity">

    <EditText
            android:id="@+id/nr_soldati_et"
            android:hint="@string/numarul_de_soldati"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    <EditText
            android:id="@+id/tara_et"
            android:hint="@string/tara"
            android:inputType="text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    <CheckBox
            android:id="@+id/in_razboi_cb"
            android:text="@string/este_in_razboi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    <EditText
            android:id="@+id/nr_tancuri_et"
            android:hint="@string/numarul_de_tancuri"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


    <Button
            android:id="@+id/add_btn"
            android:text="@string/adauga_armata"
            android:onClick="addArmy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

</LinearLayout>